{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "certificates",
    "description": "The main window may list the certificates on this computer and in ILM,.",
    "windows": ["main"],
    "permissions": [
        "allow-local-certificates",
        "allow-ilm-status",
        "allow-ilm-certificates",
        "allow-sync-now",
        "allow-make-sign-in-certificate",
        "allow-add-to-ilm-choices",
        "allow-add-to-ilm"
    ]
}

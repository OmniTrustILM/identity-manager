{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Identity Manager",
    "identifier": "com.omnitrust.identity-manager",
    "build": {
        "frontendDist": "../../app/dist",
        "devUrl": "http://localhost:5173"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Identity Manager",
                "width": 1080,
                "height": 720
            }
        ],
        "security": {
            "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
        }
    },
    "bundle": {
        "active": true,
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "macOS": {
            "signingIdentity": "-"
        }
    }
}

{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Identity Manager",
    "identifier": "com.omnitrust.identity-manager",
    "build": {
        "frontendDist": "../../app/dist",
        "devUrl": "http://localhost:5173"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Identity Manager",
                "width": 1080,
                "height": 720,
                "minWidth": 760,
                "minHeight": 480
            },
            {
                "label": "summary",
                "title": "Identity Manager",
                "visible": false,
                "decorations": false,
                "resizable": false,
                "skipTaskbar": true,
                "alwaysOnTop": true,
                "acceptFirstMouse": true,
                "width": 340,
                "height": 160
            }
        ],
        "macOSPrivateApi": true,
        "security": {
            "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
        }
    },
    "plugins": {
        "updater": {
            "endpoints": [
                "https://github.com/OmniTrustILM/identity-manager/releases/latest/download/latest.json"
            ],
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4ODc5MDQ2NUQ1NjQyQTUKUldTbFFsWmRScENIMkJrTGRwakFVRXVzNlV0WmVVYVR6VytSYmR6Nyt5eTNZNm9kbHdXaG9GTDkK",
            "requireSignedVersion": true,
            "windows": {
                "installMode": "passive"
            }
        }
    },
    "bundle": {
        "active": true,
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "macOS": {
            "signingIdentity": "-"
        }
    }
}

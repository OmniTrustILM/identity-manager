{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": ["vite/client", "node"]
    },
    "include": ["src", "playwright", "vite.config.ts", "vitest.config.ts", "playwright-ct.config.ts"]
}

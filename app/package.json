{
    "name": "identity-manager-ui",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.22.0"
    },
    "scripts": {
        "dev": "vite",
        "tauri": "tauri",
        "build": "tsc --noEmit && vite build",
        "lint": "biome check .",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:cov": "vitest run --coverage"
    },
    "dependencies": {
        "@tauri-apps/api": "^2.12.4",
        "react": "^19.2.4",
        "react-dom": "^19.2.4"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.6",
        "@tailwindcss/vite": "~4.2.4",
        "@tauri-apps/cli": "^2.12.4",
        "@types/node": "^25.5.2",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react-swc": "^4.3.0",
        "@vitest/coverage-v8": "^4.1.3",
        "happy-dom": "^21.0.4",
        "tailwindcss": "~4.2.4",
        "typescript": "^6.0.2",
        "vite": "^8.0.7",
        "vitest": "^4.1.3"
    }
}

Windows Registry Editor Version 5.00

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\OmniTrustILM\IdentityManager]
"StartAtLogin"=dword:00000000
"LogLevel"="debug"
"IlmUrl"="https://ilm.example.com"
"RequireUnlock"=dword:00000001
"LockAfterIdle"=dword:0000000f
"CheckInterval"=dword:0000001e
"ExpiryWarningDays"=dword:0000001e
"SignInProvider"="Corporate"
"SignInMethod"="oauth"
"KeyStorages"="software,tpm"
"DefaultKeyStorage"="software"
